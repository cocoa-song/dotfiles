#!/usr/bin/env python3
"""dotfiles 를 최신으로 맞춘다. 여러 번 돌려도 안전하다.

    ~/dotfiles/bin/sync

하는 일은 셋뿐이다 — pull 하고, 빠진 심링크를 걸고, Brewfile 을 맞춘다.
심링크가 저장소를 가리키므로 기존 파일의 내용 변경은 pull 만으로 반영된다.
pull 이 못 하는 건 ① 새로 추가된 파일의 링크와 ② 바뀐 Brewfile 설치뿐이다.

이미 맞는 건 건드리지 않고, 남의 파일은 절대 덮어쓰지 않는다.
확인할 게 있으면 종료코드 1.

Python 3.9(=CLT 동봉 버전)에서 돌아야 하므로 그 이후 문법을 쓰지 않는다.
표준 라이브러리만 쓴다 — 부트스트랩 시점에 pip 은 없다.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

# 셔뱅이 env 라 brew python(현재 3.14)이 있으면 그쪽으로, 없으면 CLT 의
# 3.9.6 으로 돈다. 새 기기에서는 후자뿐이다 — Brewfile 에 python 이 없고,
# 애초에 이 스크립트가 그 Brewfile 을 설치하는 쪽이라 의존할 수 없다.
# 그래서 코드는 3.9 문법에 맞춘다. 여기서 그 대가는 사실상 없었다.
if sys.version_info < (3, 9):
    sys.exit("python 3.9 이상이 필요하다 (현재 {}.{}). /usr/bin/python3 로 실행해 볼 것."
             .format(sys.version_info[0], sys.version_info[1]))

HOME = Path.home()
DOTFILES = HOME / "dotfiles"

# 저장소 안의 경로 → 홈의 링크 위치
LINKS = [
    ("nvim", HOME / ".config/nvim"),
    ("ghostty", HOME / ".config/ghostty"),
    ("starship.toml", HOME / ".config/starship.toml"),
    ("git/ignore", HOME / ".config/git/ignore"),
    ("zsh/zshrc", HOME / ".zshrc"),
    ("zsh/zprofile", HOME / ".zprofile"),
    ("zsh/zsh_plugins.txt", HOME / ".zsh_plugins.txt"),
]

# 추적하지 않는 로컬 파일. 존재만 본다 — 내용은 신원 정보라 들여다보지 않는다.
LOCAL_FILES = [
    (HOME / ".zshenv", 'README "zsh" 소절 참고'),
    (HOME / ".gitconfig", 'README "git" 소절 참고'),
]


class Report:
    """출력과 상태를 한곳에서 관리한다.

    셸 판에서는 이 카운터가 파이프 서브셸 안에서 증가해 유실됐다
    (경고 4건을 2건으로 셌다). 여기서는 그런 일이 구조적으로 없다.
    """

    def __init__(self) -> None:
        self.changed = False
        self.warnings = 0

    def head(self, text: str) -> None:
        print("▸ " + text)

    def did(self, text: str) -> None:
        print("  + " + text)
        self.changed = True

    def skip(self, text: str) -> None:
        print("  · " + text)

    def warn(self, text: str) -> None:
        print("  ⚠ " + text)
        self.warnings += 1

    def plain(self, text: str) -> None:
        print(text)


def tilde(p: Path) -> str:
    """홈 경로를 ~ 로 줄인다. 링크 대상이 길어 줄바꿈이 생긴다."""
    s = str(p)
    h = str(HOME)
    return "~" + s[len(h):] if s.startswith(h) else s


def run(cmd, cwd=None, env=None):
    """외부 명령 실행. 예외 대신 CompletedProcess 를 돌려준다."""
    e = dict(os.environ)
    e["HOMEBREW_NO_AUTO_UPDATE"] = "1"
    if env:
        e.update(env)
    return subprocess.run(
        cmd, cwd=cwd, env=e, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True,
    )


def indent(text: str, prefix: str = "  ") -> str:
    return "\n".join(prefix + line for line in text.rstrip("\n").splitlines())


# ── 1. pull ──────────────────────────────────────────────────────────
def do_pull(r: Report) -> None:
    r.head("pull")
    before = run(["git", "rev-parse", "HEAD"], cwd=DOTFILES).stdout.strip()

    p = run(["git", "pull", "--ff-only", "--quiet"], cwd=DOTFILES)
    if p.returncode != 0:
        # 셸 판은 set -e 로 조용히 죽었다. 여기서는 이유를 보여주고 멈춘다.
        r.warn("git pull 실패 — 아래를 해결하고 다시 돌릴 것")
        print(indent(p.stdout, "    "))
        sys.exit(2)

    after = run(["git", "rev-parse", "HEAD"], cwd=DOTFILES).stdout.strip()
    if before == after:
        r.skip("이미 최신")
        return

    log = run(["git", "--no-pager", "log", "--oneline", before + ".." + after],
              cwd=DOTFILES).stdout
    print(indent(log))
    r.changed = True


# ── 2. 심링크 ────────────────────────────────────────────────────────
def do_links(r: Report) -> None:
    r.head("링크")
    for rel, dst in LINKS:
        target = DOTFILES / rel

        if not target.exists():
            r.warn("저장소에 없음: " + rel)
            continue

        if dst.is_symlink():
            # 이미 링크 — 올바른 곳을 가리키는지만 본다
            if dst.readlink() == target:
                continue
            r.warn("다른 곳을 가리킴: {} -> {}".format(tilde(dst), dst.readlink()))
            continue

        if dst.exists():
            # 실제 파일이 있다 — 덮어쓰지 않는다. 사람이 판단할 일.
            r.warn("실제 파일이 이미 있음(건드리지 않음): " + tilde(dst))
            continue

        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.symlink_to(target)
        r.did(tilde(dst))


# ── 3. brew ──────────────────────────────────────────────────────────
def do_brew(r: Report) -> None:
    r.head("brew")
    brewfile = DOTFILES / "Brewfile"

    if shutil.which("brew") is None:
        r.warn("brew 가 없다 — 먼저 설치할 것")
        return

    check = run(["brew", "bundle", "check", "--file", str(brewfile)])
    if check.returncode == 0:
        r.skip("이미 충족")
        return

    p = run(["brew", "bundle", "--file", str(brewfile)])
    if p.stdout.strip():
        print(indent(p.stdout))
    if p.returncode != 0:
        r.warn("brew bundle 실패 — 위 출력 확인")
        return
    r.changed = True


# ── 4. 추적하지 않는 로컬 파일 ───────────────────────────────────────
def do_local_files(r: Report) -> None:
    r.head("로컬 파일")
    missing = False
    for path, hint in LOCAL_FILES:
        if not path.is_file():
            r.warn("{} 없음 — {}".format(tilde(path), hint))
            missing = True
    if not missing:
        r.skip("있음")


def main() -> int:
    if not (DOTFILES / ".git").exists():
        print("{} 가 git 저장소가 아니다.".format(tilde(DOTFILES)), file=sys.stderr)
        return 2

    r = Report()
    do_pull(r)
    do_links(r)
    do_brew(r)
    do_local_files(r)

    print()
    if r.changed:
        r.plain("설정이 바뀌었다 — 떠 있는 셸에 반영하려면: exec zsh")
    if r.warnings:
        r.plain("확인할 것 {}건 (위 ⚠)".format(r.warnings))
        return 1
    r.plain("이상 없음")
    return 0


if __name__ == "__main__":
    sys.exit(main())
