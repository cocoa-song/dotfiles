#!/bin/sh
# dotfiles 를 최신으로 맞춘다. 여러 번 돌려도 안전하다.
#
#   ~/dotfiles/bin/sync
#
# 하는 일은 셋뿐이다 — pull 하고, 빠진 심링크를 걸고, Brewfile 을 맞춘다.
# 이미 맞는 건 건드리지 않고, 남의 파일은 절대 덮어쓰지 않는다.

set -eu
DOTFILES="$HOME/dotfiles"
cd "$DOTFILES"

# 저장소 안의 경로 → 홈의 링크 위치
LINKS="
nvim                ${HOME}/.config/nvim
ghostty             ${HOME}/.config/ghostty
starship.toml       ${HOME}/.config/starship.toml
git/ignore          ${HOME}/.config/git/ignore
zsh/zshrc           ${HOME}/.zshrc
zsh/zprofile        ${HOME}/.zprofile
zsh/zsh_plugins.txt ${HOME}/.zsh_plugins.txt
"

changed=0
warned=0

say()  { printf '%s\n' "$*"; }
warn() { printf '  ⚠ %s\n' "$*"; warned=$((warned + 1)); }
# 홈 경로를 ~ 로 줄여 읽히게 한다 (링크 대상이 길어서 줄바꿈이 생긴다)
tilde() { printf '%s' "$1" | sed "s|^$HOME|~|"; }

# ── 1. pull ──────────────────────────────────────────────────────────
say "▸ pull"
before=$(git rev-parse HEAD)
git pull --ff-only --quiet
after=$(git rev-parse HEAD)

if [ "$before" = "$after" ]; then
	say "  이미 최신"
else
	git --no-pager log --oneline "$before..$after" | sed 's/^/  /'
	changed=1
fi

# ── 2. 심링크 ────────────────────────────────────────────────────────
say "▸ 링크"
# 파이프가 아니라 here-doc 으로 먹인다 — 파이프는 서브셸이라 warned 증가가
# 사라진다(실제로 4건을 2건으로 세는 버그가 있었다).
while read -r src dst; do
	[ -z "$src" ] && continue
	target="$DOTFILES/$src"

	if [ ! -e "$target" ]; then
		warn "저장소에 없음: $src"
		continue
	fi

	if [ -L "$dst" ]; then
		# 이미 링크 — 올바른 곳을 가리키는지만 본다
		if [ "$(readlink "$dst")" = "$target" ]; then
			continue
		fi
		warn "다른 곳을 가리킴: $(tilde "$dst") -> $(readlink "$dst")"
		continue
	fi

	if [ -e "$dst" ]; then
		# 실제 파일이 있다 — 덮어쓰지 않는다. 사람이 판단할 일.
		warn "실제 파일이 이미 있음(건드리지 않음): $(tilde "$dst")"
		continue
	fi

	mkdir -p "$(dirname "$dst")"
	ln -s "$target" "$dst"
	say "  + $(tilde "$dst")"
	changed=1
done <<EOF
$LINKS
EOF

# ── 3. brew ──────────────────────────────────────────────────────────
say "▸ brew"
if ! command -v brew >/dev/null 2>&1; then
	warn "brew 가 없다 — 먼저 설치할 것"
elif HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file Brewfile >/dev/null 2>&1; then
	say "  이미 충족"
else
	HOMEBREW_NO_AUTO_UPDATE=1 brew bundle --file Brewfile | sed 's/^/  /'
	changed=1
fi

# ── 4. 추적하지 않는 로컬 파일이 있는지만 확인 (내용은 보지 않는다) ──
say "▸ 로컬 파일"
local_missing=0
if [ ! -f "$HOME/.zshenv" ]; then
	warn "~/.zshenv 없음 — README \"zsh\" 소절 참고"
	local_missing=1
fi
if [ ! -f "$HOME/.gitconfig" ]; then
	warn "~/.gitconfig 없음 — README \"git\" 소절 참고"
	local_missing=1
fi
if [ "$local_missing" -eq 0 ]; then
	say "  있음"
fi

# ── 마무리 ───────────────────────────────────────────────────────────
# `[ ] && ...` 대신 if 를 쓴다 — set -e 아래에서 조건이 거짓이면 스크립트가
# 거기서 끝나버릴 수 있다.
say ""
if [ "$changed" -eq 1 ]; then
	say "설정이 바뀌었다 — 떠 있는 셸에 반영하려면: exec zsh"
fi
if [ "$warned" -gt 0 ]; then
	say "확인할 것 ${warned}건 (위 ⚠)"
	exit 1
fi
say "이상 없음"
exit 0
