#!/usr/bin/env python3
"""dotfiles 를 최신으로 맞춘다. 여러 번 돌려도 안전하다.

    ~/dotfiles/bin/sync

하는 일은 셋뿐이다 — pull 하고, 빠진 심링크를 걸고, Brewfile 을 맞춘다.
심링크가 저장소를 가리키므로 기존 파일의 내용 변경은 pull 만으로 반영된다.
pull 이 못 하는 건 ① 새로 추가된 파일의 링크와 ② 바뀐 Brewfile 설치뿐이다.

이미 맞는 건 건드리지 않고, 남의 파일은 절대 덮어쓰지 않는다.
확인할 게 있으면 종료코드 1.
"""

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _bootstrap  # noqa: E402

# 여기서 Homebrew python + rich 로 갈아탄다. 아래 코드는 그 환경에서만 돈다.
_bootstrap.ensure(create=False)

from _ui import UI  # noqa: E402

HOME = Path.home()
DOTFILES = _bootstrap.DOTFILES

LINKS = [
    ("nvim", HOME / ".config/nvim"),
    ("ghostty", HOME / ".config/ghostty"),
    ("starship.toml", HOME / ".config/starship.toml"),
    ("git/ignore", HOME / ".config/git/ignore"),
    ("zsh/zshrc", HOME / ".zshrc"),
    ("zsh/zprofile", HOME / ".zprofile"),
    ("zsh/zsh_plugins.txt", HOME / ".zsh_plugins.txt"),
]

# 추적하지 않는 로컬 파일. 존재만 본다 — 내용은 신원 정보라 들여다보지 않는다.
LOCAL_FILES = [
    (HOME / ".zshenv", "zsh"),
    (HOME / ".gitconfig", "git"),
]


def tilde(p: Path) -> str:
    s, h = str(p), str(HOME)
    return "~" + s[len(h):] if s.startswith(h) else s


def run(cmd, cwd=None):
    env = dict(os.environ, HOMEBREW_NO_AUTO_UPDATE="1")
    return subprocess.run(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, text=True)


def step_pull(ui: UI) -> None:
    with ui.step("pull") as s:
        before = run(["git", "rev-parse", "HEAD"], cwd=DOTFILES).stdout.strip()
        p = run(["git", "pull", "--ff-only", "--quiet"], cwd=DOTFILES)
        if p.returncode != 0:
            s.fail("git pull 실패", output=p.stdout,
                   hint="충돌이나 미커밋 변경을 정리하고 다시 실행할 것\n"
                        "cd {} && git status".format(tilde(DOTFILES)))
            return
        after = run(["git", "rev-parse", "HEAD"], cwd=DOTFILES).stdout.strip()
        if before == after:
            s.skip("이미 최신")
            return
        n = len(run(["git", "log", "--oneline", before + ".." + after],
                    cwd=DOTFILES).stdout.strip().splitlines())
        s.ok("커밋 {}개 받음".format(n))


def step_links(ui: UI) -> None:
    with ui.step("링크") as s:
        created, problems = [], []
        for rel, dst in LINKS:
            target = DOTFILES / rel
            if not target.exists():
                problems.append("저장소에 {} 가 없다".format(rel))
                continue
            if dst.is_symlink():
                if dst.readlink() != target:
                    problems.append(
                        "{} 가 {} 를 가리킨다 (기대: {})".format(
                            tilde(dst), dst.readlink(), tilde(target)))
                continue
            if dst.exists():
                problems.append(
                    "{} 에 실제 파일이 있다 — 확인 후 옮기거나 지울 것".format(tilde(dst)))
                continue
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.symlink_to(target)
            created.append(tilde(dst))

        if problems:
            s.warn("{}건 확인 필요".format(len(problems)), hint="\n".join(problems))
        elif created:
            s.ok("{}개 생성".format(len(created)))
            for c in created:
                ui.note(c)
        else:
            s.skip("이상 없음")


def step_brew(ui: UI) -> None:
    with ui.step("패키지") as s:
        brewfile = DOTFILES / "Brewfile"
        if shutil.which("brew") is None:
            s.fail("brew 가 없다",
                   hint="Homebrew 를 설치하고 다시 실행할 것\n"
                        "~/dotfiles/bin/setup")
            return
        if run(["brew", "bundle", "check", "--file", str(brewfile)]).returncode == 0:
            s.skip("충족")
            return

        s.progress("설치 중…")
        p = run(["brew", "bundle", "--file", str(brewfile)])
        if p.returncode != 0:
            # 흔한 실패는 원인을 짚어준다. "위 출력 확인" 은 안내가 아니다.
            if "untrusted tap" in p.stdout:
                hint = ("서드파티 탭을 신뢰해야 한다:\n"
                        "brew trust laishulu/homebrew\n"
                        "쓰지 않을 거면 Brewfile 에서 tap/macism 두 줄을 지울 것")
            elif "No available formula" in p.stdout:
                hint = ("Brewfile 의 이름이 틀렸거나 탭이 빠졌다. 위 줄을 확인할 것")
            else:
                hint = "위 오류를 해결하고 다시 실행할 것"
            s.fail("brew bundle 실패", output=p.stdout, hint=hint)
            return
        n = sum(1 for l in p.stdout.splitlines() if l.startswith("Installing"))
        s.ok("{}개 설치".format(n) if n else "충족")


def step_local(ui: UI) -> None:
    with ui.step("로컬 파일") as s:
        missing = [(p, d) for p, d in LOCAL_FILES if not p.is_file()]
        if not missing:
            s.skip("있음")
            return
        s.warn("{}개 없음".format(len(missing)),
               hint="\n".join("{} — {}/README.md 참고".format(tilde(p), d)
                              for p, d in missing))


def main() -> int:
    ap = argparse.ArgumentParser(description="dotfiles 를 최신으로 맞춘다.")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="생략 없이 전부 보여준다")
    args = ap.parse_args()

    if not (DOTFILES / ".git").exists():
        print("{} 가 git 저장소가 아니다.".format(DOTFILES), file=sys.stderr)
        return 2

    ui = UI(verbose=args.verbose)
    ui.title("dotfiles sync", tilde(DOTFILES))
    step_pull(ui)
    step_links(ui)
    step_brew(ui)
    step_local(ui)
    return ui.done("이상 없음")


if __name__ == "__main__":
    sys.exit(main())
